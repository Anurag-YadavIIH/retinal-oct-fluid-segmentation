# Pinned by digest, not by tag: a tag is mutable and defeats reproducible builds.
# Resolved from the registry 2026-09-17; SOUP-017 in docs/04 records the same value.
# Changing this line means updating that row and a change control entry.
FROM python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install --upgrade pip && pip install .

# Non-root: the service has no reason to run privileged.
RUN useradd --create-home --uid 10001 ocuval
USER ocuval

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
    CMD python -c "import urllib.request;urllib.request.urlopen('http://localhost:8000/health')"

CMD ["uvicorn", "ocuval.service.api:app", "--host", "0.0.0.0", "--port", "8000"]
