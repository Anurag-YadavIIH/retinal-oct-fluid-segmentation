# Normalise line endings. Without this, core.autocrlf on a Windows clone checks
# these files out with CRLF, which breaks shell scripts and Dockerfiles inside the
# Linux containers (docker/) and shows every line as changed across platforms.
# Git stores LF; these paths also get LF in the working tree everywhere.

* text=auto

*.sh        text eol=lf
Dockerfile* text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.cfg       text eol=lf
# The report page is compared byte for byte with what scripts/08_build_site.py renders
# (TC-130), which writes LF; a CRLF checkout of these would fail that test on Windows only.
site/**     text eol=lf
site_src/** text eol=lf
